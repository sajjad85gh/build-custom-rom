+    private fun setDimAlpha(alpha: Float) {
+        if (!attached) return
+        // Apply alpha to the window only so view.alpha and window.alpha do not multiply.
+        dimLayoutParams.alpha = alpha
+        try {
+            windowManager.updateViewLayout(view, dimLayoutParams)
+        } catch (e: IllegalArgumentException) {
+            Log.e(TAG, "View not attached to WindowManager", e)
